{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": [
    "audio/**/*.d.ts",
    "audio/**/*.ts",
    "score/**/*.ts",
    "practice/**/*.ts",
    "storage/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}