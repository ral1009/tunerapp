{
  "name": "sheet-music-tuner",
  "version": "0.1.0",
  "private": true,
  "description": "Phase-driven build for violin sheet music tuner",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "phase0:validate": "tsx audio/__tests__/offline-validation/runValidation.ts"
  },
  "dependencies": {
    "pitchfinder": "^2.3.2",
    "wav-decoder": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
